@page "/"

@inject IEmployeeConverter EmployeeConverter
@inject IEmployeeService EmployeeService
@inject ILogger<Home> Logger

<PageTitle>Home</PageTitle>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Employee Collaboration Analyzer</h2>
            <p>Identify employee pairs who have worked together on common projects for the longest period of time</p>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <Card Class="mb-4">
                <CardHeader Class="bg-primary text-white">
                    <h5 class="mb-0">Upload Employee Data</h5>
                </CardHeader>
                <CardBody>
                    <EditForm Model="Input" method="post" OnValidSubmit="LoadEmployees" FormName="addFileForm">
                        <DataAnnotationsValidator />

                        <div class="form-group mb-3">
                            <label for="csvFile" class="form-label">Select CSV File:</label>
                            <InputFile id="csvFile" class="form-control" OnChange="@LoadFile" accept=".csv" />
                            <ValidationMessage For="() => Input!.CsvFile" class="text-danger small mt-1" />
                            <small class="text-muted d-block mt-2">
                                Expected format: EmployeeID, ProjectID, DateFrom, DateTo (Max 5 MB)
                            </small>
                        </div>

                        <div class="button-group d-flex gap-2">
                            <Button Color="ButtonColor.Primary" Type="ButtonType.Submit" Disabled="@(Input?.CsvFile == null)">Analyze</Button>
                            <Button Color="ButtonColor.Secondary" Type="ButtonType.Reset" @onclick="ClearAll">Clear</Button>
                        </div>
                    </EditForm>
                </CardBody>
            </Card>

            @if (EmployeeIdsPairs is not null && EmployeeIdsPairs.Any())
            {
                <Card Class="mb-4">
                    <CardHeader Class="bg-info">
                        <h5 class="mb-0">Top Collaborators</h5>
                    </CardHeader>
                    <CardBody>
                        <div class="list-group">
                            @foreach (var kvp in EmployeeIdsPairs)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">
                                            <i class="bi bi-people-fill"></i>
                                            Employee <span class="badge bg-info">@kvp.Key</span>
                                            &amp;
                                            Employee <span class="badge bg-info">@kvp.Value</span>
                                        </h6>
                                    </div>
                                </div>
                            }
                        </div>
                    </CardBody>
                </Card>
            }
        </div>

        <div class="col-md-4">
            <Card Class="sticky-top">
                <CardHeader Class="bg-light">
                    <h6 class="mb-0">How It Works</h6>
                </CardHeader>
                <CardBody>
                    <ol class="small">
                        <li>Upload a CSV file with employee project information</li>
                        <li>Click Analyze to process the data</li>
                        <li>View employee pairs with longest collaboration time</li>
                    </ol>
                </CardBody>
            </Card>
        </div>
    </div>

    @if (EmployeesPerProject is not null && EmployeesPerProject.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <EmployeesGrid TModel="EmployeesViewModel" Employees="@EmployeesPerProject"></EmployeesGrid>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h6 class="alert-heading">
                <i class="bi bi-exclamation-triangle"></i> Error
            </h6>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }
</div>

@code {
    private const long MaxFileSize = 5 * 1024 * 1024;

    [SupplyParameterFromForm]
    private FileInputModel? Input { get; set; }

    private IEnumerable<KeyValuePair<int, int>>? EmployeeIdsPairs { get; set; }
    private IEnumerable<EmployeesViewModel>? EmployeesPerProject { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        EmployeeIdsPairs = [];
        EmployeesPerProject = [];
    }

    private void LoadFile(InputFileChangeEventArgs e)
    {
        Input!.CsvFile = e.GetMultipleFiles().FirstOrDefault();
        ErrorMessage = null;
    }

    private async Task LoadEmployees()
    {
        if (Input?.CsvFile == null)
        {
            ErrorMessage = "Please select a file first.";
            return;
        }

        try
        {
            var hasError = false;
            var employeesGroupsPerProject = new Dictionary<int, List<Employee>>();

            using (var reader = new StreamReader(Input.CsvFile.OpenReadStream(MaxFileSize)))
            using (var csv = new CsvReader(reader, CultureInfo.InvariantCulture))
            {
                await foreach (var employeeInput in csv.GetRecordsAsync<EmployeeInput>())
                {
                    var employeeConverterResult = EmployeeConverter.ConvertEmployeeInput(employeeInput);
                    if (!employeeConverterResult.IsSuccessful())
                    {
                        foreach (var error in employeeConverterResult.Errors)
                            Logger.LogWarning(error);
                        hasError = true;
                        continue;
                    }

                    var employee = employeeConverterResult.Employee!;
                    if (!employeesGroupsPerProject.TryGetValue(employee.ProjectId, out var group))
                    {
                        group = [];
                        employeesGroupsPerProject[employee.ProjectId] = group;
                    }

                    group.Add(employee);
                }
            }

            if (employeesGroupsPerProject.Count == 0)
            {
                ErrorMessage = "No valid employee records found in the file.";
                return;
            }
            else if (hasError)
            {
                ErrorMessage = "Note: There was some wrong data in the submitted file.";
            }

            var employeeServiceResult = EmployeeService.GetPairEmployeesWorkedLongest(employeesGroupsPerProject);
            if (!employeeServiceResult.IsSuccessful())
            {
                ErrorMessage = string.Join(" ", employeeServiceResult.Errors);
                return;
            }

            EmployeesPerProject = employeeServiceResult.EmployeesPerProject;
            EmployeeIdsPairs = employeeServiceResult.EmployeesPerProject.Select(ep => new KeyValuePair<int, int>(ep.EmployeeOneId, ep.EmployeeTwoId)).Distinct();
        }
        catch (IOException ex) when (ex.Message.Contains("exceeds the maximum allow size"))
        {
            ErrorMessage = "The uploaded file is too large. Please upload a file smaller than 5MB.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing employee file");
            ErrorMessage = "An unexpected error occurred while processing the file. Please try again.";
        }
    }

    private void ClearAll()
    {
        Input = new();
        EmployeeIdsPairs = [];
        EmployeesPerProject = [];
        ErrorMessage = null;
    }
}
