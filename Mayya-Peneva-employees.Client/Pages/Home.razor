@page "/"

@inject IEmployeeService EmployeeService

<PageTitle>Home</PageTitle>

<container>
    <h1>Employees</h1>

    Shows employees who have worked together on common projects.
    <hr />

    <EditForm Model="Input" method="post" OnValidSubmit="LoadEmployees" FormName="addFileForm">
        <DataAnnotationsValidator />
        <div class="form-group">
            <div class="row">
                <h6>Pick up a file from your file system:</h6>
                <div class="col-md-8">
                    <InputFile class="form-control" OnChange="@LoadFile" />
                    <ValidationMessage For="() => Input!.CsvFile" class="text-danger" />
                </div>
                <div class="col-md-4">
                    <Button Type="ButtonType.Submit">Select</Button>
                </div>
            </div>
        </div>
    </EditForm>

    @if (EmployeesPerProject is not null && EmployeesPerProject.Any())
    {
        <div>
            <Card Style="width:40rem;">
                <CardBody>
                    <label>The employees who have worked together on common projects for the longest period of time are:</label>
                    @foreach (var kvp in EmployeeIdsPairs)
                    {
                        <CardText>Employees with Ids @kvp.Key and @kvp.Value</CardText>
                    }
                </CardBody>
            </Card>
        </div>

        <EmployeesGrid TModel="EmployeesViewModel" Employees="@EmployeesPerProject"></EmployeesGrid>
    }

</container>

@code {
    [SupplyParameterFromForm]
    private FileInputModel? Input { get; set; }

    private IEnumerable<KeyValuePair<int, int>> EmployeeIdsPairs { get; set; }

    private IEnumerable<EmployeesViewModel>? EmployeesPerProject { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        EmployeesPerProject = new List<EmployeesViewModel>();
    }

    private void LoadFile(InputFileChangeEventArgs e)
    {
        Input!.CsvFile = e.GetMultipleFiles().FirstOrDefault();
    }

    private async Task LoadEmployees()
    {
        if (Input is not null && Input.CsvFile is not null)
        {
            var employeeList = new List<Employee>();
            using (var reader = new StreamReader(Input.CsvFile.OpenReadStream()))
            using (var csv = new CsvReader(reader, CultureInfo.InvariantCulture))
            {
                await foreach (var employeeInput in csv.GetRecordsAsync<EmployeeInput>())
                {
                    var employee = employeeInput.ConvertToEmployee();
                    if (employee is not null)
                        employeeList.Add(employee);

                    //TODO: Handle invalid input (e.g. log it, show error message to user etc.)
                }
            }

            var result = EmployeeService.GetPairEmployeesWorkedLongest(employeeList);
            if (result.IsSuccessful())
            {
                EmployeeIdsPairs = result.EmployeeIdsWorkedTogether;
                EmployeesPerProject = result.EmployeesPerProject;
            }
        }
    }
}
